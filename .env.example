# Neon Postgres
# Obtain a connection string for your database from the Connection Details widget on the Neon Dashboard.
DATABASE_URL="<postgres://user:pass@host/db>"

# Better Auth
# Generate an auth secret using `openssl rand -base64 32`
BETTER_AUTH_SECRET="<generated-secret-at-least-32-chars>"
# Set the base URL of your application. Set to your production Vercel URL for production.
BETTER_AUTH_BASE_URL="http://localhost:5001"

# Required for the protected Vercel Cron endpoint that generates due recurring entries.
# Keep this server-only value out of NEXT_PUBLIC_* variables.
CRON_SECRET="<strong-random-secret>"

# Optional AI classification fallback for statement imports (server-only)
AI_GATEWAY_API_KEY=""
IMPORT_AI_ENABLED="false"
IMPORT_AI_MODEL="openai/gpt-4o-mini"
IMPORT_AI_MAX_UNIQUE_MERCHANTS="60"
